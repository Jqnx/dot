{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/theme-schema.json",
  "name": "noctalia",
  "vars": {
    "mantle": "{{ colors.surface_container_lowest.default.hex }}",
    "low": "{{ colors.surface_container_low.default.hex }}",
    "mid": "{{ colors.surface_container.default.hex }}",
    "high": "{{ colors.surface_container_high.default.hex }}",
    "highest": "{{ colors.surface_container_highest.default.hex }}",
    "text": "{{ colors.on_surface.default.hex }}",
    "subtext": "{{ colors.on_surface_variant.default.hex }}",
    "outline": "{{ colors.outline.default.hex }}",
    "outlineVariant": "{{ colors.outline_variant.default.hex }}",
    "primary": "{{ colors.primary.default.hex }}",
    "secondary": "{{ colors.secondary.default.hex }}",
    "tertiary": "{{ colors.tertiary.default.hex }}",

    "red": "{{ colors.red.default.hex }}",
    "green": "{{ colors.green.default.hex }}",
    "yellow": "{{ colors.yellow.default.hex }}",
    "blue": "{{ colors.blue.default.hex }}",
    "magenta": "{{ colors.magenta.default.hex }}",
    "cyan": "{{ colors.cyan.default.hex }}",

    "successBg": "{{ colors.surface_container_low.default.hex | blend: '#22c55e', 1 | saturate 10 }}",
    "errorBg": "{{ colors.surface_container_low.default.hex | blend: '#ef4444', 1 | saturate 10 }}"
  },
  "colors": {
    "accent": "primary",
    "border": "outlineVariant",
    "borderAccent": "primary",
    "borderMuted": "high",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "subtext",
    "dim": "outline",
    "text": "",
    "thinkingText": "subtext",

    "selectedBg": "highest",
    "userMessageBg": "low",
    "userMessageText": "",
    "customMessageBg": "high",
    "customMessageText": "",
    "customMessageLabel": "tertiary",
    "toolPendingBg": "mantle",
    "toolSuccessBg": "successBg",
    "toolErrorBg": "errorBg",
    "toolTitle": "",
    "toolOutput": "subtext",

    "mdHeading": "primary",
    "mdLink": "blue",
    "mdLinkUrl": "subtext",
    "mdCode": "tertiary",
    "mdCodeBlock": "text",
    "mdCodeBlockBorder": "high",
    "mdQuote": "subtext",
    "mdQuoteBorder": "outline",
    "mdHr": "outlineVariant",
    "mdListBullet": "primary",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "outline",

    "syntaxComment": "outline",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "text",
    "syntaxString": "green",
    "syntaxNumber": "yellow",
    "syntaxType": "cyan",
    "syntaxOperator": "subtext",
    "syntaxPunctuation": "outline",

    "thinkingOff": "outlineVariant",
    "thinkingMinimal": "outline",
    "thinkingLow": "blue",
    "thinkingMedium": "cyan",
    "thinkingHigh": "primary",
    "thinkingXhigh": "tertiary",
    "thinkingMax": "magenta",

    "bashMode": "cyan",
    "pythonMode": "yellow",

    "statusLineBg": "mantle",
    "statusLineSep": "outlineVariant",
    "statusLineModel": "primary",
    "statusLinePath": "cyan",
    "statusLineGitClean": "green",
    "statusLineGitDirty": "yellow",
    "statusLineContext": "secondary",
    "statusLineSpend": "tertiary",
    "statusLineStaged": "green",
    "statusLineDirty": "yellow",
    "statusLineUntracked": "red",
    "statusLineOutput": "subtext",
    "statusLineCost": "magenta",
    "statusLineSubagents": "primary"
  },
  "export": {
    "pageBg": "mantle",
    "cardBg": "low",
    "infoBg": "mid"
  }
}
