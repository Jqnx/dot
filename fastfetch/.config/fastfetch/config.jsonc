{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/dawg.png",
    "width": 30,
    "height": 12
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta"
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB"
    },
    "key": {
      "type": "icon"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "red",
        "host": "blue"
      }
    },
    {
      "type": "os",
      "format": "{pretty-name}"
    },
    "kernel",
    "uptime",
    {
      "type": "shell",
      "format": "{pretty-name}"
    },
    "memory",
    {
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "packages",
    "battery",
    "localip",
    "dns",
    {
      "type": "media",
      "format": "{artist} - {title} ({#green}{player-name}{#white})"
    }
  ]
}
